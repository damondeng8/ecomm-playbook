DESCRIPTION >
    Per-arm readout for one experiment: the numbers the optimizer routines decide on (ecomm-experiments skill).
    A visitor counts in the arm of their first experiment_exposed event, and only for outcomes after it.
    Returns one row per arm with exposed, converted, checkout and ordering visitors, cash, margin, and for each
    test arm the relative lift and two-sided p-value against the control arm (two-proportion z-test).
    Copy to tinybird/endpoints/. Expects the events datasource: event, ts, visitor_id, props (JSON string), env.

TOKEN optimizer_read READ

NODE first_exposure
SQL >
    %
    SELECT
        visitor_id,
        argMin(JSONExtractString(props, 'variant'), ts) AS variant,
        min(ts) AS first_exposed
    FROM events
    WHERE event = 'experiment_exposed'
        AND env = {{ String(env, 'production') }}
        AND JSONExtractString(props, 'experiment_id') = {{ String(experiment_id, required=True) }}
        AND ts >= {{ DateTime(since, '2020-01-01 00:00:00') }}
        AND ts < now()
        AND visitor_id IS NOT NULL
    GROUP BY visitor_id

NODE outcome_events
SQL >
    %
    SELECT visitor_id, event, ts, JSONExtractFloat(props, 'value') AS value, JSONExtractFloat(props, 'margin') AS margin
    FROM events
    WHERE event IN ({{ String(primary_event, 'add_to_cart') }}, 'checkout_started', 'order_placed', 'order_refunded')
        AND env = {{ String(env, 'production') }}
        AND ts >= {{ DateTime(since, '2020-01-01 00:00:00') }}
        AND ts < now()
        AND visitor_id IN (SELECT visitor_id FROM first_exposure)

NODE per_user
SQL >
    %
    SELECT
        x.visitor_id AS visitor_id,
        x.variant AS variant,
        max(o.event = {{ String(primary_event, 'add_to_cart') }} AND o.ts >= x.first_exposed) AS converted,
        max(o.event = 'checkout_started' AND o.ts >= x.first_exposed) AS checkout,
        max(o.event = 'order_placed' AND o.ts >= x.first_exposed) AS ordered,
        sumIf(o.value, o.event = 'order_placed' AND o.ts >= x.first_exposed)
            - sumIf(o.value, o.event = 'order_refunded' AND o.ts >= x.first_exposed) AS cash,
        sumIf(o.margin, o.event = 'order_placed' AND o.ts >= x.first_exposed) AS margin
    FROM first_exposure AS x
    LEFT JOIN outcome_events AS o ON o.visitor_id = x.visitor_id
    GROUP BY x.visitor_id, x.variant

NODE per_arm
SQL >
    SELECT
        variant,
        count() AS exposed_visitors,
        sum(converted) AS converted_visitors,
        sum(checkout) AS checkout_visitors,
        sum(ordered) AS ordering_visitors,
        sum(cash) AS cash,
        sum(margin) AS margin
    FROM per_user
    GROUP BY variant

NODE readout
SQL >
    %
    SELECT
        a.variant AS variant,
        a.exposed_visitors AS exposed_visitors,
        a.converted_visitors AS converted_visitors,
        a.checkout_visitors AS checkout_visitors,
        a.ordering_visitors AS ordering_visitors,
        a.cash AS cash,
        a.margin AS margin,
        a.ordering_visitors / a.exposed_visitors AS order_rate,
        a.margin / a.exposed_visitors AS margin_per_exposed,
        a.converted_visitors / a.exposed_visitors AS conversion_rate,
        a.checkout_visitors / a.exposed_visitors AS checkout_rate,
        a.cash / a.exposed_visitors AS cash_per_exposed,
        if(a.variant = c.variant OR c.converted_visitors = 0, NULL,
            (a.converted_visitors / a.exposed_visitors) / (c.converted_visitors / c.exposed_visitors) - 1) AS lift_vs_control,
        if(a.variant = c.variant OR pooled = 0 OR pooled = 1, NULL,
            erfc(abs(a.converted_visitors / a.exposed_visitors - c.converted_visitors / c.exposed_visitors)
                / sqrt(pooled * (1 - pooled) * (1 / a.exposed_visitors + 1 / c.exposed_visitors)) / sqrt(2))) AS p_value_vs_control,
        (a.converted_visitors + c.converted_visitors) / (a.exposed_visitors + c.exposed_visitors) AS pooled
    FROM per_arm AS a
    CROSS JOIN (SELECT * FROM per_arm WHERE variant = {{ String(control, 'control') }}) AS c
    ORDER BY variant
TYPE endpoint
